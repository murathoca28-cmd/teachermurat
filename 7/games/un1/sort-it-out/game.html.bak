<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sort It Out</title>
<style>
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { height: 100%; margin: 0; overflow: hidden; }
  body { height: 100dvh; display: flex; flex-direction: column;
    font-family: 'Segoe UI', Verdana, Tahoma, Arial, system-ui, sans-serif; background: #0E8F86; color: #0B2F2C; }
  button { font-family: inherit; cursor: pointer; }
  #fs-btn { position: fixed; top: 8px; right: 8px; z-index: 50; width: 48px; height: 48px; border-radius: 50%;
    border: 4px solid #0B2F2C; background: #fff; color: #0B2F2C; display: flex; align-items: center; justify-content: center; padding: 0; }
  #fs-btn svg { width: 26px; height: 26px; }
  #start-screen, #win-screen { position: fixed; inset: 0; z-index: 40; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 3vh; text-align: center; padding: 20px; background: #0E8F86; }
  #win-screen { display: none; background: rgba(11,47,44,.9); color: #fff; }
  .title { margin: 0; font-size: clamp(2rem, 7vw, 5rem); font-weight: 900; color: #fff; text-shadow: 3px 3px 0 #0B2F2C; line-height: 1.1; }
  .subtitle { margin: 0; font-size: clamp(1.2rem, 3vw, 2rem); font-weight: 800; color: #fff; }
  .big-btn { font-size: clamp(1.6rem, 4vw, 3rem); font-weight: 900; padding: .35em 1.4em; border: 5px solid #0B2F2C;
    border-radius: 999px; background: #FFD23F; color: #0B2F2C; box-shadow: 0 6px 0 #0B2F2C; }
  .big-btn:active { transform: translateY(4px); box-shadow: 0 2px 0 #0B2F2C; }
  .preview { font-size: clamp(2rem, 6vw, 4rem); letter-spacing: .15em; }
  .win-title { font-size: clamp(2.5rem, 9vw, 6rem); font-weight: 900; margin: 0; color: #FFD23F; }
  .win-stats { font-size: clamp(1.4rem, 4vw, 2.6rem); font-weight: 800; margin: 0; }
  .stat { background: #fff; border: 4px solid #0B2F2C; border-radius: 14px; padding: 2px 16px;
    font-size: clamp(1rem, 2.4vw, 1.7rem); font-weight: 900; white-space: nowrap; }
  #topbar { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; gap: 12px; padding: 8px 70px 4px 12px; flex-wrap: wrap; }
  .restart-btn { background: #FFD23F; border: 4px solid #0B2F2C; border-radius: 14px; padding: 2px 16px;
    font-size: clamp(1rem, 2.4vw, 1.7rem); font-weight: 900; color: #0B2F2C; }
  @keyframes shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-8px); } 75% { transform: translateX(8px); } }
  .shake { animation: shake .4s; }
  body.no-tr .tr { display: none; }

  #main { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 10px; padding: 6px 12px 12px; }
  #head { text-align: center; background: #fff; border: 5px solid #0B2F2C; border-radius: 18px; padding: 2px 14px; }
  #h-en { font-weight: 900; font-size: clamp(1.2rem, 3vw, 2.2rem); }
  #h-tr { font-weight: 800; font-size: clamp(.9rem, 1.8vw, 1.3rem); color: #0B5C56; }
  #pool { flex: 0 0 auto; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; align-content: center; min-height: 28%; }
  .word { background: #fff; border: 5px solid #0B2F2C; border-radius: 14px; padding: 2px 12px; display: flex; flex-direction: column; align-items: center; min-width: clamp(84px, 11vw, 150px); }
  .word .e { font-size: clamp(1.6rem, 6vh, 3rem); line-height: 1.1; }
  .word .e svg { width: clamp(1.8rem, 6.5vh, 3.2rem); height: clamp(1.8rem, 6.5vh, 3.2rem); display: block; }
  .word .p { font-weight: 900; font-size: clamp(.95rem, 2.2vw, 1.6rem); line-height: 1.1; }
  .word .t { font-weight: 800; font-size: clamp(.7rem, 1.4vw, 1rem); color: #0B5C56; }
  .word.sel { background: #FFF3B0; border-color: #D62828; border-width: 7px; }
  .word.gone { display: none; }
  #bins { flex: 1; min-height: 0; display: flex; gap: 12px; }
  @media (orientation: portrait) { #bins { flex-direction: column; } }
  .bin { flex: 1; min-width: 0; min-height: 0; background: #fff; border: 6px solid #0B2F2C; border-radius: 20px; display: flex; flex-direction: column; overflow: hidden; cursor: pointer; }
  .bin .bh { color: #fff; text-align: center; padding: 4px 8px; border-bottom: 6px solid #0B2F2C; }
  .bin .bh .be { font-size: clamp(1.6rem, 5vh, 2.8rem); line-height: 1.1; }
  .bin .bh .bn { font-weight: 900; font-size: clamp(1.1rem, 2.8vw, 2.2rem); line-height: 1.1; text-shadow: 2px 2px 0 #0B2F2C; }
  .bin .bh .bt { font-weight: 800; font-size: clamp(.8rem, 1.6vw, 1.2rem); }
  .bin .chips { flex: 1; display: flex; flex-wrap: wrap; align-content: flex-start; gap: 6px; padding: 8px; }
  .chip { background: #C8F7D4; border: 4px solid #0A7A2F; border-radius: 12px; padding: 0 10px; font-weight: 900; font-size: clamp(.9rem, 2vw, 1.5rem); display: flex; align-items: center; gap: 6px; }
  .chip svg { width: 1.4em; height: 1.4em; }
  #fb { min-height: 1.3em; text-align: center; font-weight: 900; font-size: clamp(1rem, 2.4vw, 1.8rem); color: #fff; text-shadow: 2px 2px 0 #0B2F2C; }
  #next { display: none; align-self: center; font-size: clamp(1.1rem, 2.6vw, 1.7rem); }
</style>
<style id="ln-css">
.ln-btn { background: #fff !important; font-size: clamp(1.1rem, 2.6vw, 1.9rem) !important; }
:where(.tile .e, .cell .e, .wc .e, .fe, .ct, #qmark, .w .e, .word .e, #pic) svg { width: 1em; height: 1em; display: inline-block; vertical-align: middle; }
#ln-screen { display: none; position: fixed; inset: 0; z-index: 70; background: #0E8F86; flex-direction: column; gap: 8px; padding: 8px 10px 10px; font-family: 'Segoe UI', Verdana, Tahoma, Arial, system-ui, sans-serif; color: #0B2F2C; }
#ln-top { flex: 0 0 auto; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
#ln-title { font-weight: 900; font-size: clamp(1.3rem, 3.4vw, 2.4rem); color: #fff; text-shadow: 3px 3px 0 #0B2F2C; margin-right: 6px; }
#ln-tabs { display: flex; flex-wrap: wrap; gap: 8px; flex: 1; }
.ln-tab { font-weight: 900; font-size: clamp(.9rem, 2.1vw, 1.5rem); padding: .05em .8em; border: 4px solid #0B2F2C; border-radius: 12px; background: #fff; color: #0B2F2C; cursor: pointer; font-family: inherit; }
.ln-tab.act { background: #FFD23F; border-color: #D62828; }
#ln-close { font-weight: 900; font-size: clamp(.95rem, 2.2vw, 1.5rem); padding: .05em .9em; border: 4px solid #0B2F2C; border-radius: 12px; background: #D62828; color: #fff; cursor: pointer; font-family: inherit; }
#ln-grid { flex: 1; min-height: 0; overflow: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(clamp(140px, 17vw, 240px), 1fr)); gap: 10px; align-content: start; padding: 2px; }
.ln-card { background: #fff; border: 5px solid #0B2F2C; border-radius: 16px; padding: 6px 8px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; }
.ln-card.wide { grid-column: span 2; }
.ln-card .le { font-size: clamp(2rem, 7vh, 3.6rem); line-height: 1.1; }
.ln-card .le svg { width: clamp(2.4rem, 8vh, 4rem); height: clamp(2.4rem, 8vh, 4rem); display: block; }
.ln-card .en { font-weight: 900; font-size: clamp(1rem, 2.3vw, 1.6rem); line-height: 1.15; }
.ln-card .trl { font-weight: 800; font-size: clamp(.8rem, 1.7vw, 1.15rem); color: #0B5C56; }
</style>
</head>
<body>
<button id="fs-btn" onclick="toggleFullScreen()" title="Fullscreen / Exit" aria-label="Fullscreen / Exit">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
</button>
<div id="start-screen">
  <h1 class="title">Sort<br>It Out</h1>
  <p class="subtitle">Put each word in the right box!</p>
  <div class="preview">💇 👓 👍</div>
  <button class="big-btn" onclick="startGame()">Start</button>
  <button class="big-btn ln-btn" onclick="lnOpen()">📖 Learn</button>
</div>
<div id="win-screen">
  <h2 class="win-title" id="win-title">You Win!</h2>
  <p class="win-stats" id="win-stats"></p>
  <button class="big-btn" onclick="startGame()">Play Again</button>
</div>
<div id="topbar">
  <div class="stat">Round: <span id="rn">1</span>/3</div>
  <div class="stat">Mistakes: <span id="mi">0</span></div>
  <button class="restart-btn" id="trbtn" onclick="toggleTR()">Turkish: On</button>
  <button class="restart-btn" onclick="startGame()">Restart</button>
</div>
<div id="main">
  <div id="head"><div id="h-en"></div><div id="h-tr" class="tr"></div></div>
  <div id="pool"></div>
  <div id="bins"></div>
  <div id="fb"></div>
  <button class="big-btn" id="next" onclick="nextRound()">Next</button>
</div>
<script>
  function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
  function toggleFullScreen() {
    if (!document.fullscreenElement && !document.webkitFullscreenElement) {
      var el = document.documentElement; (el.requestFullscreen || el.webkitRequestFullscreen || el.msRequestFullscreen).call(el);
    } else { (document.exitFullscreen || document.webkitExitFullscreen || document.msExitFullscreen).call(document); }
  }

  var TR = true, fbParts = null;
  function setFb(p, tr) { fbParts = [p, tr]; renderFb(); }
  function renderFb() { var f = document.getElementById('fb'); if (f) f.textContent = fbParts ? fbParts[0] + (TR && fbParts[1] ? ' ' + fbParts[1] : '') : ''; }
  function toggleTR() { TR = !TR; document.body.classList.toggle('no-tr', !TR); document.getElementById('trbtn').textContent = 'Turkish: ' + (TR ? 'On' : 'Off'); renderFb(); }
  var ROUNDS = [["Where does it belong?", "Hangi gruba ait?", [["hair", "Hair", "Saç", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"straight\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "#7B2CBF"], ["agew", "Age & Weight", "Yaş ve Kilo", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"plump\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "#D62828"], ["eyes", "Eyes & Height", "Göz ve Boy", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"blue eyes\"><path d=\"M8 50 Q50 10 92 50 Q50 90 8 50 Z\" fill=\"#fff\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke-width=\"4.5\"/><circle cx=\"50\" cy=\"50\" r=\"22\" fill=\"#2E86DE\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" /><circle cx=\"50\" cy=\"50\" r=\"10\" fill=\"#111\"/><circle cx=\"43\" cy=\"42\" r=\"5\" fill=\"#fff\"/></svg>", "#1F5FBF"], ["face", "Face & Extras", "Yüz ve Aksesuarlar", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"glasses\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "#0A7A2F"]], [["hair", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"curly\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "curly hair", "kıvırcık saç"], ["hair", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"straight\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "straight hair", "düz saç"], ["hair", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"shorthair\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "short hair", "kısa saç"], ["agew", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"slim\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "slim", "ince, zayıf"], ["agew", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"plump\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "plump", "tombul"], ["agew", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"old\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "old", "yaşlı"], ["eyes", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"blue eyes\"><path d=\"M8 50 Q50 10 92 50 Q50 90 8 50 Z\" fill=\"#fff\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke-width=\"4.5\"/><circle cx=\"50\" cy=\"50\" r=\"22\" fill=\"#2E86DE\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" /><circle cx=\"50\" cy=\"50\" r=\"10\" fill=\"#111\"/><circle cx=\"43\" cy=\"42\" r=\"5\" fill=\"#fff\"/></svg>", "blue eyes", "mavi gözler"], ["eyes", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"hazel eyes\"><path d=\"M8 50 Q50 10 92 50 Q50 90 8 50 Z\" fill=\"#fff\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke-width=\"4.5\"/><circle cx=\"50\" cy=\"50\" r=\"22\" fill=\"#A8842C\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" /><circle cx=\"50\" cy=\"50\" r=\"10\" fill=\"#111\"/><circle cx=\"43\" cy=\"42\" r=\"5\" fill=\"#fff\"/><path d=\"M50 50 L50 30 M50 50 L67 40 M50 50 L33 40 M50 50 L66 60 M50 50 L34 60\" stroke=\"#5A8F3A\" stroke-width=\"2.5\" fill=\"none\"/><circle cx=\"50\" cy=\"50\" r=\"10\" fill=\"#111\"/></svg>", "hazel eyes", "ela gözler"], ["eyes", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"tall\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "tall", "uzun boylu"], ["face", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"glasses\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "glasses", "gözlük"], ["face", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"moustache\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "moustache", "bıyık"], ["face", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"headscarf\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "headscarf", "başörtüsü"]]], ["Positive or negative?", "Olumlu mu, olumsuz mu?", [["pos", "Positive (+)", "Olumlu", "👍", "#0A7A2F"], ["neg", "Negative (–)", "Olumsuz", "👎", "#D62828"]], [["pos", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"generous\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "generous", "cömert"], ["pos", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"helpful\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "helpful", "yardımsever"], ["pos", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"hardworking\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "hardworking", "çalışkan"], ["pos", "🙏", "polite", "kibar"], ["neg", "😴", "lazy", "tembel"], ["neg", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"stubborn\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "stubborn", "inatçı"], ["neg", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"spilled glass\"><path d=\"M20 70 Q50 98 80 70 Z\" fill=\"#DDF3FF\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" /><path d=\"M14 40 L40 18 L58 38 L30 70 Z\" fill=\"#DDF3FF\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"  transform=\"rotate(-18 36 44)\"/><path d=\"M60 72 Q70 60 74 72 Q70 82 60 72 Z\" fill=\"#7CC6FF\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke-width=\"2.5\"/><circle cx=\"82\" cy=\"52\" r=\"5\" fill=\"#7CC6FF\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke-width=\"2.5\"/><circle cx=\"90\" cy=\"66\" r=\"4\" fill=\"#7CC6FF\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke-width=\"2.5\"/><path d=\"M8 90 H92\" stroke=\"#0B2F2C\" stroke-width=\"4\" stroke-linecap=\"round\"/></svg>", "clumsy", "sakar"], ["neg", "🙋", "selfish", "bencil"]]], ["Look like or be like?", "Görünüş mü, kişilik mi?", [["look", "What does she look like?", "Dış görünüş", "👀", "#1F5FBF"], ["like", "What is she like?", "Kişilik", "💛", "#7B2CBF"]], [["look", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"wavy\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "wavy hair", "dalgalı saç"], ["look", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"gray\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "gray hair", "gri saç"], ["look", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"beard\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "beard", "sakal"], ["look", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"green eyes\"><path d=\"M8 50 Q50 10 92 50 Q50 90 8 50 Z\" fill=\"#fff\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke-width=\"4.5\"/><circle cx=\"50\" cy=\"50\" r=\"22\" fill=\"#2FA84F\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" /><circle cx=\"50\" cy=\"50\" r=\"10\" fill=\"#111\"/><circle cx=\"43\" cy=\"42\" r=\"5\" fill=\"#fff\"/></svg>", "green eyes", "yeşil gözler"], ["look", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"short\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "short", "kısa boylu"], ["look", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"young\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "young", "genç"], ["like", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"punctual\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "punctual", "dakik"], ["like", "🤣", "funny", "komik"], ["like", "🦁", "brave", "cesur"], ["like", "🤗", "kind", "nazik"], ["like", "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"smart\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "smart", "zeki"], ["like", "🎨", "creative", "yaratıcı"]]]];
  var ri, sel, left, mistakes;
  function startGame() {
    document.getElementById('start-screen').style.display = 'none';
    document.getElementById('win-screen').style.display = 'none';
    ri = 0; mistakes = 0; document.getElementById('mi').textContent = 0; showRound();
  }
  function showRound() {
    var r = ROUNDS[ri]; sel = null; left = r[3].length;
    document.getElementById('rn').textContent = ri + 1;
    document.getElementById('h-en').textContent = r[0]; document.getElementById('h-tr').textContent = r[1];
    fbParts = null; renderFb(); document.getElementById('next').style.display = 'none';
    var bins = document.getElementById('bins'); bins.innerHTML = '';
    r[2].forEach(function (b) {
      var d = document.createElement('div'); d.className = 'bin'; d.dataset.id = b[0];
      d.innerHTML = '<div class="bh" style="background:' + b[4] + '"><div class="be">' + b[3] + '</div><div class="bn">' + b[1] + '</div><div class="bt tr">' + b[2] + '</div></div><div class="chips"></div>';
      d.addEventListener('click', function () { dropIn(d); });
      bins.appendChild(d);
    });
    var pool = document.getElementById('pool'); pool.innerHTML = '';
    shuffle(r[3].slice()).forEach(function (w) {
      var b = document.createElement('button'); b.className = 'word'; b.dataset.bin = w[0];
      b.innerHTML = '<div class="e">' + w[1] + '</div><div class="p">' + w[2] + '</div><div class="t tr">' + w[3] + '</div>';
      b.addEventListener('click', function () { if (sel) sel.classList.remove('sel'); sel = (sel === b) ? null : b; if (sel) sel.classList.add('sel'); });
      b._w = w; pool.appendChild(b);
    });
  }
  function dropIn(bin) {
    if (!sel) { setFb('👆 Tap a word first.', 'Önce bir kelimeye dokun.'); return; }
    var w = sel._w;
    if (sel.dataset.bin === bin.dataset.id) {
      var c = document.createElement('span'); c.className = 'chip'; c.innerHTML = w[1] + ' ' + w[2];
      bin.querySelector('.chips').appendChild(c);
      sel.classList.add('gone'); sel = null; left--; fbParts = null; renderFb();
      if (left === 0) {
        setFb('✔ All sorted!', 'Hepsi doğru yerde!');
        var nx = document.getElementById('next'); nx.textContent = (ri === ROUNDS.length - 1) ? 'Finish' : 'Next'; nx.style.display = 'inline-block';
      }
    } else {
      mistakes++; document.getElementById('mi').textContent = mistakes;
      sel.classList.add('shake'); var s = sel; setTimeout(function () { s.classList.remove('shake'); }, 450);
      setFb('✘ Not this box. Try again!', 'Bu kutu değil. Tekrar dene!');
    }
  }
  function nextRound() {
    ri++;
    if (ri >= ROUNDS.length) {
      document.getElementById('win-title').textContent = mistakes <= 2 ? 'Super Sorter!' : (mistakes <= 6 ? 'Well Done!' : 'Good Try!');
      document.getElementById('win-stats').textContent = 'Mistakes: ' + mistakes;
      document.getElementById('win-screen').style.display = 'flex'; return;
    }
    showRound();
  }
</script>
<div id="ln-screen">
  <div id="ln-top"><div id="ln-title">📖 Learn</div><div id="ln-tabs"></div><button id="ln-close" onclick="lnClose()">Close ✕</button></div>
  <div id="ln-grid"></div>
</div>
<script>
(function () {
  var LN = [["Hair and Eyes", "Saç ve Gözler", [["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"curly\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "curly hair", "kıvırcık saç"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"straight\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "straight hair", "düz saç"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"wavy\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "wavy hair", "dalgalı saç"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"blonde\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "blonde hair", "sarı saç"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"gray\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "gray hair", "gri (beyaz) saç"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"black\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "black hair", "siyah saç"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"brown\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "brown hair", "kahverengi saç"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"red\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "red hair", "kızıl saç"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"blue eyes\"><path d=\"M8 50 Q50 10 92 50 Q50 90 8 50 Z\" fill=\"#fff\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke-width=\"4.5\"/><circle cx=\"50\" cy=\"50\" r=\"22\" fill=\"#2E86DE\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" /><circle cx=\"50\" cy=\"50\" r=\"10\" fill=\"#111\"/><circle cx=\"43\" cy=\"42\" r=\"5\" fill=\"#fff\"/></svg>", "blue eyes", "mavi gözler"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"green eyes\"><path d=\"M8 50 Q50 10 92 50 Q50 90 8 50 Z\" fill=\"#fff\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke-width=\"4.5\"/><circle cx=\"50\" cy=\"50\" r=\"22\" fill=\"#2FA84F\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" /><circle cx=\"50\" cy=\"50\" r=\"10\" fill=\"#111\"/><circle cx=\"43\" cy=\"42\" r=\"5\" fill=\"#fff\"/></svg>", "green eyes", "yeşil gözler"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"brown eyes\"><path d=\"M8 50 Q50 10 92 50 Q50 90 8 50 Z\" fill=\"#fff\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke-width=\"4.5\"/><circle cx=\"50\" cy=\"50\" r=\"22\" fill=\"#7A4A22\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" /><circle cx=\"50\" cy=\"50\" r=\"10\" fill=\"#111\"/><circle cx=\"43\" cy=\"42\" r=\"5\" fill=\"#fff\"/></svg>", "brown eyes", "kahverengi gözler"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"hazel eyes\"><path d=\"M8 50 Q50 10 92 50 Q50 90 8 50 Z\" fill=\"#fff\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke-width=\"4.5\"/><circle cx=\"50\" cy=\"50\" r=\"22\" fill=\"#A8842C\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" /><circle cx=\"50\" cy=\"50\" r=\"10\" fill=\"#111\"/><circle cx=\"43\" cy=\"42\" r=\"5\" fill=\"#fff\"/><path d=\"M50 50 L50 30 M50 50 L67 40 M50 50 L33 40 M50 50 L66 60 M50 50 L34 60\" stroke=\"#5A8F3A\" stroke-width=\"2.5\" fill=\"none\"/><circle cx=\"50\" cy=\"50\" r=\"10\" fill=\"#111\"/></svg>", "hazel eyes", "ela gözler"]]], ["Face and Extras", "Yüz ve Aksesuarlar", [["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"glasses\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "glasses", "gözlük"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"moustache\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "moustache", "bıyık"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"beard\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "beard", "sakal"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"headscarf\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "headscarf", "başörtüsü"], ["😊", "a nice smile", "güzel bir gülümseme"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"hat\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "hat", "şapka"]]], ["Height, Weight, Age", "Boy, Kilo, Yaş", [["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"tall\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "tall", "uzun boylu"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"short\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "short", "kısa boylu"], ["📏", "medium height", "orta boylu"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"slim\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "slim", "ince, zayıf"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"plump\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "plump", "tombul"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"strong\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "well-built", "yapılı, güçlü"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"young\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "young", "genç"], ["🧑", "middle-aged", "orta yaşlı"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"old\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "old", "yaşlı"]]], ["Positive Traits", "Olumlu Özellikler", [["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"generous\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "generous", "cömert"], ["⚖️", "honest", "dürüst"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"helpful\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "helpful", "yardımsever"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"hardworking\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "hardworking", "çalışkan"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"punctual\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "punctual", "dakik"], ["🙏", "polite", "kibar"], ["🤗", "kind", "nazik, iyi kalpli"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"smart\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "smart", "zeki"], ["🤣", "funny", "komik"], ["🦁", "brave", "cesur"], ["😎", "easy-going", "rahat, uyumlu"], ["🎉", "outgoing", "girişken, sosyal"]]], ["Negative Traits", "Olumsuz Özellikler", [["🙋", "selfish", "bencil"], ["😠", "rude", "kaba"], ["😴", "lazy", "tembel"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"stubborn\"><image href=\"data:image/webp;base64,\" x=\"0\" y=\"0\" width=\"100\" height=\"100\" preserveAspectRatio=\"xMidYMid meet\"/></svg>", "stubborn", "inatçı"], ["<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"spilled glass\"><path d=\"M20 70 Q50 98 80 70 Z\" fill=\"#DDF3FF\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" /><path d=\"M14 40 L40 18 L58 38 L30 70 Z\" fill=\"#DDF3FF\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"  transform=\"rotate(-18 36 44)\"/><path d=\"M60 72 Q70 60 74 72 Q70 82 60 72 Z\" fill=\"#7CC6FF\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke-width=\"2.5\"/><circle cx=\"82\" cy=\"52\" r=\"5\" fill=\"#7CC6FF\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke-width=\"2.5\"/><circle cx=\"90\" cy=\"66\" r=\"4\" fill=\"#7CC6FF\" stroke=\"#0B2F2C\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke-width=\"2.5\"/><path d=\"M8 90 H92\" stroke=\"#0B2F2C\" stroke-width=\"4\" stroke-linecap=\"round\"/></svg>", "clumsy", "sakar"], ["⏳", "impatient", "sabırsız"]]]];
  function lnShow(i) {
    Array.prototype.forEach.call(document.querySelectorAll('.ln-tab'), function (b, k) { b.classList.toggle('act', k === i); });
    document.getElementById('ln-grid').innerHTML = LN[i][2].map(function (it) {
      var wide = it[1].length > 26 && it[0].indexOf('<svg') < 0;
      return '<div class="ln-card' + (wide ? ' wide' : '') + '"><div class="le">' + it[0] + '</div><div class="en">' + it[1] + '</div><div class="trl">' + it[2] + '</div></div>';
    }).join('');
    document.getElementById('ln-grid').scrollTop = 0;
  }
  window.lnOpen = function () {
    var tabs = document.getElementById('ln-tabs'); tabs.innerHTML = '';
    LN.forEach(function (s, i) { var b = document.createElement('button'); b.className = 'ln-tab'; b.textContent = s[0]; b.onclick = function () { lnShow(i); }; tabs.appendChild(b); });
    document.getElementById('ln-screen').style.display = 'flex'; lnShow(0);
  };
  window.lnClose = function () { document.getElementById('ln-screen').style.display = 'none'; };
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') window.lnClose(); });
})();
</script>
</body>
</html>
